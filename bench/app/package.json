{
  "name": "isr-engine-bench-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "最小可启动的 ISR bench 应用 —— 专供 CI bench 用，不依赖 sibling 业务项目",
  "scripts": {
    "build": "vite build",
    "start": "node ../../dist/cli/cli.js start",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist node_modules"
  },
  "dependencies": {
    "isr-engine": "file:../..",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "sass-embedded": "^1.108.2",
    "typescript": "^6.0.3",
    "vite": "8.3.8"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.9",
      "qs": "6.17.1",
      "proxy-addr": "2.0.8"
    }
  }
}
