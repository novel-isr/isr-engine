{
  "name": "isr-engine",
  "version": "1.0.0",
  "description": "ISR/SSG/Fallback rendering orchestration on Vite + React 19 RSC.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novel-isr/isr-engine.git"
  },
  "homepage": "https://github.com/novel-isr/isr-engine",
  "bugs": "https://github.com/novel-isr/isr-engine/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/isr-engine.cjs",
  "module": "./dist/isr-engine.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "isr-engine": "./dist/cli/cli.js"
  },
  "files": [
    "dist",
    "src/context",
    "src/defaults",
    "src/runtime",
    "src/types",
    "src/utils",
    "!src/**/__tests__/**",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/isr-engine.js",
      "require": "./dist/isr-engine.cjs",
      "types": "./dist/index.d.ts"
    },
    "./rsc": {
      "browser": "./dist/rsc/browser.js",
      "import": "./dist/rsc/index.js",
      "require": "./dist/rsc/index.cjs",
      "types": "./dist/rsc/index.d.ts"
    },
    "./server-entry": {
      "default": "./src/defaults/runtime/defineServerEntry.tsx"
    },
    "./client-entry": {
      "default": "./src/defaults/runtime/defineClientEntry.tsx"
    },
    "./auto-observability": {
      "types": "./dist/defaults/auto-observability.d.ts",
      "import": "./dist/defaults/auto-observability.js",
      "require": "./dist/defaults/auto-observability.cjs"
    },
    "./site-hooks": {
      "types": "./dist/defaults/runtime/defineSiteHooks.d.ts",
      "import": "./dist/defaults/runtime/defineSiteHooks.js",
      "require": "./dist/defaults/runtime/defineSiteHooks.cjs"
    },
    "./config": {
      "types": "./dist/config/defineConfig.d.ts",
      "import": "./dist/config/defineConfig.js",
      "require": "./dist/config/defineConfig.cjs"
    },
    "./adapters/observability": {
      "import": "./dist/adapters/observability/index.js",
      "require": "./dist/adapters/observability/index.cjs",
      "types": "./dist/adapters/observability/index.d.ts"
    },
    "./adapters/runtime": {
      "import": "./dist/adapters/runtime/index.js",
      "require": "./dist/adapters/runtime/index.cjs",
      "types": "./dist/adapters/runtime/index.d.ts"
    },
    "./image": {
      "import": "./dist/image/index.js",
      "require": "./dist/image/index.cjs",
      "types": "./dist/runtime/Image.d.ts"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./src/runtime/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && chmod +x dist/cli/cli.js dist/cli/cli.cjs",
    "watch": "vite build --watch",
    "clean": "rimraf dist",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "pretest:browser": "pnpm run build",
    "test:browser:production": "pnpm run build && playwright test --config playwright.production.config.ts",
    "test:browser": "playwright test e2e/dev-css-lifecycle/dev-css-lifecycle.spec.ts",
    "bench": "node bench/runner.mjs",
    "check": "pnpm run type-check && pnpm run lint && pnpm run test",
    "audit:security": "pnpm audit --registry=https://registry.npmjs.org --audit-level=low",
    "prepublishOnly": "pnpm run audit:security",
    "release": "semantic-release",
    "prepare": "husky",
    "test:package": "node scripts/check-package-exports.mjs",
    "test:package:installed": "node scripts/check-installed-package.mjs",
    "test:workers": "tsc --noEmit -p scripts/fixtures/tsconfig.json && node scripts/check-workers-runtime.mjs",
    "test:release": "node scripts/check-release.mjs"
  },
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@vitejs/plugin-rsc": "0.5.39",
    "chalk": "^6.0.1",
    "commander": "^12.1.0",
    "compression": "^1.8.2",
    "css-tree": "^3.2.1",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "lru-cache": "^10.4.3",
    "ora": "^10.0.0",
    "parse5": "^8.0.1",
    "pino": "10.4.0",
    "prom-client": "^15.1.3",
    "rsc-html-stream": "0.0.7",
    "sharp": "^0.35.5",
    "sitemap": "^10.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.1.6"
  },
  "optionalDependencies": {
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/compression": "^1.7.5",
    "@types/css-tree": "^3.2.0",
    "@types/express": "^5.0.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "24.19.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.9.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "ioredis-mock": "^8.9.0",
    "miniflare": "4.20260730.0",
    "prettier": "^3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "^6.1.4",
    "sass-embedded": "^1.108.2",
    "semantic-release": "25.0.9",
    "tsc-alias": "^1.9.10",
    "undici": "8.12.4",
    "vite": "8.1.6",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "miniflare>sharp": "0.35.5",
      "hyperid": "4.0.0",
      "fast-uri": "3.1.9",
      "minimatch@3.1.5>brace-expansion": "1.1.21",
      "qs": "6.17.1",
      "tmp": "0.2.7",
      "ws": "8.21.0",
      "proxy-addr": "2.0.8",
      "undici@7": "7.30.2",
      "js-yaml@4": "4.3.2",
      "form-data@4": "4.0.6",
      "@typescript-eslint/typescript-estree>minimatch": "11.0.5"
    }
  }
}
